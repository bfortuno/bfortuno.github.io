---
import Icon from './Icon.astro';

interface Highlight {
  label: string;
  href: string;
  icon?: 'contact' | 'cv' | 'github' | 'linkedin' | 'paper' | 'project' | 'scholar';
}

interface Props {
  items: Highlight[];
}

const { items } = Astro.props;
---

<nav class="highlight-links" aria-label="Highlights">
  <ul>
    {
      items.map((item) => (
        <li>
          <a class="btn btn-outline highlight-link" href={item.href}>
            {item.icon && <Icon name={item.icon} class="highlight-link-icon" />}
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
