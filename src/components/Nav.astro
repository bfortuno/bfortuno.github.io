---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/', label: 'Home' },
  { href: '/publications', label: 'Publications' },
  // Hidden for now (content not ready to show) - flip to true to re-enable.
  { href: '/projects', label: 'Projects', visible: false },
  { href: '/cv', label: 'CV' },
  { href: '/news', label: 'News', visible: false },
  { href: '/contact', label: 'Contact' },
];

const visibleLinks = links.filter((link) => link.visible !== false);

const currentPath = Astro.url.pathname;

const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(href + '/');
---

<nav class="site-nav" aria-label="Main navigation">
  <a class="brand" href="/">Benjamin I. Fortuno</a>
  <ul class="nav-links">
    {
      visibleLinks.map((link) => (
        <li>
          <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
  <ThemeToggle />
</nav>
