---
interface Props {
  date: string;
  text: string;
  link?: string;
}

const { date, text, link } = Astro.props;

const formattedDate = new Date(`${date}T00:00:00`).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<li class="news-entry">
  <time class="news-entry-date" datetime={date}>{formattedDate}</time>
  <p class="news-entry-text">
    {text}
    {
      link && (
        <>
          {' '}
          <a href={link}>Read more →</a>
        </>
      )
    }
  </p>
</li>
